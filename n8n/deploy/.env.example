# Copy to .env on the server and fill in. Never commit the filled-in file.

# Domain the n8n instance answers on. Needs an A record pointing at the VPS.
N8N_HOST=n8n.thomas-toebbe.de

# Address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=toebbe.thomas@outlook.de

# Encrypts the stored credentials. Generate once with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
