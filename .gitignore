# Local credentials — the Firebase web config stays out of the repository.
# Copy src/environments/firebase.config.example.ts over it, see docs/firebase.md.
/src/environments/firebase.config.ts
/src/environments/firebase.config.prod.ts

# Server secrets — the filled-in deployment env stays on the VPS.
# Copy n8n/deploy/.env.example over it, see docs/deployment.md.
/n8n/deploy/.env

